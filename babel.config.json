{
  "presets": [
    "@babel/preset-react",
    ["@babel/preset-env", {"targets": {"node": "current"}}],
    "@babel/preset-typescript"
  ],
  "plugins": [
    "./babel-plugins/transform-import-meta-env.js",
    ["import", {
      "libraryName": "antd11",
      "libraryDirectory": "es",
      "style": "css"
    }]
  ]
}